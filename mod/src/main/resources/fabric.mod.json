{
	"schemaVersion": 1,
	"id": "foley",
	"version": "${version}",
	"name": "Foley",
	"description": "Procedurally generated, physically based sound effects and ambience. Client only.",
	"license": "MIT OR Apache-2.0",
	"icon": "assets/foley/icon.png",
	"contact": {
		"homepage": "https://github.com/cumsauce/foley",
		"sources": "https://github.com/cumsauce/foley",
		"issues": "https://github.com/cumsauce/foley/issues"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.cumsauce.foley.FoleyClient"
		],
		"modmenu": [
			"io.github.cumsauce.foley.ui.ModMenuEntry"
		]
	},
	"mixins": [
		"foley.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"earshot": "*",
		"yakvc": "*"
	}
}
